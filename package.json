{
  "name": "supercup",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npx prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "npx prisma db push",
    "db:seed": "npx ts-node -r tsconfig-paths/register --project tsconfig.seed.json prisma/seed.ts",
    "db:setup": "npx prisma db push && npx ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts",
    "db:studio": "npx prisma studio",
    "sync:live": "npx ts-node -r tsconfig-paths/register --project tsconfig.seed.json scripts/live-sync-daemon.ts",
    "verify": "npx ts-node -r tsconfig-paths/register --project tsconfig.seed.json scripts/verify_live_readiness.ts",
    "setup:test-campaign": "npx ts-node -r tsconfig-paths/register --project tsconfig.seed.json scripts/setup_prelaunch_test_campaign.ts"
  },
  "prisma": {
    "seed": "npx ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.1",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
