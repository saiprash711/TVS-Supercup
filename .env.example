

# ─── Database ─────────────────────────────────────────────────────────────────
# Local development (SQLite):
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL on GCP Cloud SQL / Vercel Postgres):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/supercup?sslmode=require"

# ─── Authentication ──────────────────────────────────────────────────────────
# Admin dashboard password (MUST be changed from default before production)
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ADMIN_PASSWORD="CHANGE_ME_BEFORE_PRODUCTION"

# Session signing secret (separate from admin password for defense-in-depth)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# ─── Internal API Security ───────────────────────────────────────────────────
# API key for internal webhook/cron endpoints
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY="CHANGE_ME_BEFORE_PRODUCTION"

# Vercel Cron Job secret (set in Vercel dashboard)
CRON_SECRET=""

# ─── Rate Limiting ───────────────────────────────────────────────────────────
# Max login attempts per IP per window (default: 5 attempts per 15 minutes)
RATE_LIMIT_LOGIN_MAX="5"
RATE_LIMIT_LOGIN_WINDOW_MS="900000"

# Max admin login attempts per IP per window (default: 3 attempts per 15 minutes)
RATE_LIMIT_ADMIN_MAX="3"
RATE_LIMIT_ADMIN_WINDOW_MS="900000"

# ─── CORS & Domain ──────────────────────────────────────────────────────────
# Allowed origins (comma-separated). Leave empty to allow same-origin only.
ALLOWED_ORIGINS="https://supercup.tvs.in,https://supercup-admin.tvs.in"

# Strict admin subdomain isolation (blocks /admin on dealer domain)
STRICT_ADMIN_SUBDOMAIN="true"

# Admin Portal Toggle:
# Set to "false" on Vercel to restrict deployment to dealer-only routes (admin runs locally on your PC)
# Set to "true" to allow admin routes in production
ENABLE_ADMIN="true"

# ─── TVS Certified API ──────────────────────────────────────────────────────
# TVS Certified API base URLs
TVS_API_BASE_URL="https://tvscertified.in:8036"
TVS_MASTER_API_BASE_URL="https://tvscertified.in:8030"

# TVS service account credentials for backend queries
TVS_SERVICE_USERNAME="CHANGE_ME_SERVICE_USER"
TVS_SERVICE_PASSWORD="CHANGE_ME_SERVICE_PASSWORD"

# Set to "true" only in dev if TVS self-signed cert needs bypass (never in prod)
TVS_TLS_INSECURE="false"

# ─── Security ────────────────────────────────────────────────────────────────
# Set to "true" in production to enforce HTTPS-only cookies
NODE_ENV="development"

# Content Security Policy report URI (optional)
CSP_REPORT_URI=""

# Enable audit logging for all API requests (recommended for production)
AUDIT_ALL_REQUESTS="true"
