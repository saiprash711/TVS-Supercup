                  <span>Admin Mission Control • Unmasked Leaderboard</span>
                  <span style={{ fontSize: '0.68rem', background: 'rgba(6, 214, 160, 0.25)', padding: '2px 8px', borderRadius: '4px', border: '1px solid rgba(6, 214, 160, 0.4)' }}>
