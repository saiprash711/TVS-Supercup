import { PrismaClient } from '@prisma/client';
import { getCurrentSuperCupCampaign } from '../src/lib/services/campaign';

const prisma = new PrismaClient();

function maskName(name: string): string {
  if (!name || name.length === 0) return '*****';
  const first = name.trim().charAt(0).toUpperCase();
  return `${first}*****`;
}

async function seedTVSDealers() {
  process.env.NODE_TLS_REJECT_UNAUTHORIZED = '0';
  const token = process.env.TVS_API_TOKEN;
  if (!token) throw new Error('TVS_API_TOKEN is required to sync dealer accounts');

  console.log('Fetching all registered dealers from TVS Certified live platform...');
  const res = await fetch('https://tvscertified.in:8036/users', {
    headers: {
      'Authorization': token,
      'Content-Type': 'application/json',
    },
  });

  const custRes = await fetch('https://tvscertified.in:8036/customers', {
    headers: {
      'Authorization': token,
      'Content-Type': 'application/json',
    },
  });

  const json = await res.json();
  const custJson = await custRes.json();
  const allUsers = json?.data || [];
  const allCusts = custJson?.data || [];

  const custMap = new Map();
  for (const c of allCusts) {
    const clean = (s: any) => (s && typeof s === 'string' && s.trim() !== 'null' && s.trim() !== 'undefined' && s.trim() !== '.') ? s.trim() : '';
    const compName = clean(c.legal_name) || clean(c.trade_name) || clean(c.name) || clean(c.company_name);
    custMap.set(String(c.id), { ...c, companyName: compName });
    if (c.code) custMap.set(String(c.code), { ...c, companyName: compName });
    if (c.mobile_no) custMap.set(String(c.mobile_no).trim(), { ...c, companyName: compName });
  }

  console.log(`Retrieved ${allUsers.length} total user accounts and ${allCusts.length} customer profiles from TVS Certified.`);

  // Filter for buyers and dealers
  const dealers = allUsers.filter((u: any) => 
    u.user_type === 'buyer' || 
    u.role_id === 21 || 
    u.key_id != null
  );
  console.log(`Processing ${dealers.length} verified dealer accounts...`);

  // Ensure active campaign exists
  let campaign = await getCurrentSuperCupCampaign();

  if (!campaign) {
    campaign = await prisma.campaign.create({
      data: {
        name: 'TVS Certified Super Cup 2026–27',
        slug: 'supercup-2026-27',
        startDate: new Date('2026-10-14T18:30:00.000Z'),
        endDate: new Date('2027-01-14T18:29:59.999Z'),
        type: 'SUPER_CUP',
        status: 'ACTIVE',
      },
    });
  }

  let imported = 0;
  let updated = 0;

  for (const u of dealers) {
    const externalDealerId = u.key_id ? String(u.key_id) : `USR-${u.id}`;
    const cust = custMap.get(String(u.key_id || '')) || custMap.get(String(u.id)) || (u.mobile ? custMap.get(String(u.mobile).trim()) : null);
    const fullName = [u.first_name, u.last_name].filter(Boolean).join(' ').trim();
    const displayName = cust?.companyName || fullName || u.user_name || u.email || `Dealer ${externalDealerId}`;
    const maskedName = maskName(displayName);
    const phone = u.mobile ? String(u.mobile).trim() : (cust?.mobile_no ? String(cust.mobile_no).trim() : null);
    const city = cust?.city || u.location_name || 'Hyderabad';

    try {
      const existing = await prisma.dealer.findUnique({
        where: { externalDealerId },
      });

      let dealerId: number;

      if (existing) {
        await prisma.dealer.update({
          where: { id: existing.id },
          data: {
            displayName,
            maskedName,
            phone: phone || existing.phone,
            city,
            status: u.active ? 'ACTIVE' : 'INACTIVE',
          },
        });
        dealerId = existing.id;
        updated++;
      } else {
        const created = await prisma.dealer.create({
          data: {
            externalDealerId,
            displayName,
            maskedName,
            phone,
            city,
            status: u.active ? 'ACTIVE' : 'INACTIVE',
          },
        });
        dealerId = created.id;
        imported++;
      }

      // Ensure score row exists
      await prisma.dealerScore.upsert({
        where: {
          dealerId_campaignId: { dealerId, campaignId: campaign.id },
        },
        update: {},
        create: {
          dealerId,
          campaignId: campaign.id,
          totalPoints: 0,
          rank: 0,
        },
      });
    } catch (err) {
      console.error(`Error saving dealer ${externalDealerId}:`, err);
    }
  }

  console.log(`\nImport Summary:`);
  console.log(`  Newly Added Dealers: ${imported}`);
  console.log(`  Updated Dealers:     ${updated}`);
  console.log(`  Total Active in DB:  ${await prisma.dealer.count()}`);

  // Recalculate rankings
  const dealerTotals = await prisma.dealerActivity.groupBy({
    by: ['dealerId'],
    where: { campaignId: campaign.id },
    _sum: { points: true },
    orderBy: { _sum: { points: 'desc' } },
  });

  const allDbDealers = await prisma.dealer.findMany({
    where: { status: 'ACTIVE' },
    select: { id: true },
  });

  const pointsMap = new Map<number, number>();
  for (const dt of dealerTotals) {
    pointsMap.set(dt.dealerId, dt._sum.points || 0);
  }
  for (const d of allDbDealers) {
    if (!pointsMap.has(d.id)) pointsMap.set(d.id, 0);
  }

  const sorted = [...pointsMap.entries()].sort((a, b) => b[1] - a[1]);
  for (let i = 0; i < sorted.length; i++) {
    const [dealerId, totalPoints] = sorted[i];
    await prisma.dealerScore.upsert({
      where: {
        dealerId_campaignId: { dealerId, campaignId: campaign.id },
      },
      update: { totalPoints, rank: i + 1 },
      create: { dealerId, campaignId: campaign.id, totalPoints, rank: i + 1 },
    });
  }

  console.log(`Rankings recalculated for ${sorted.length} dealers.`);
}

seedTVSDealers()
  .catch(console.error)
  .finally(() => prisma.$disconnect());
</file>

<file path="scripts/export_auction_csv.ts">
import { PrismaClient } from '@prisma/client';
import * as fs from 'fs';
import * as path from 'path';
import { getCurrentSuperCupCampaign } from '../src/lib/services/campaign';

const prisma = new PrismaClient();

function escapeCsv(val: any): string {
  if (val === null || val === undefined) return '';
  const str = String(val);
  if (str.includes(',') || str.includes('"') || str.includes('\n') || str.includes('\r')) {
    return `"${str.replace(/"/g, '""')}"`;
  }
  return str;
}

function formatIST(dateInput: Date | string | number) {
  const d = new Date(dateInput);
  if (isNaN(d.getTime())) return { date: '', time: '', full: '' };
  const full = d.toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' });
  const date = d.toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata' });
  const time = d.toLocaleTimeString('en-IN', { timeZone: 'Asia/Kolkata' });
  return { date, time, full, iso: d.toISOString() };
}

async function main() {
  const auctionId = '1978';
  console.log(`Generating updated CSV for Auction #${auctionId}...`);

  const campaign = await getCurrentSuperCupCampaign();

  const match = await prisma.matchDay.findFirst({
    where: { auctionId },
  });

  const activities = await prisma.dealerActivity.findMany({
    where: {
      OR: [
        ...(match ? [{ matchId: match.id }] : []),
        { externalTransactionId: { contains: auctionId } },
      ],
    },
    include: {
      dealer: true,
      match: true,
      campaign: true,
    },
    orderBy: {
      timestamp: 'desc',
    },
  });

  console.log(`Found ${activities.length} activities for Auction #${auctionId}.`);

  const headers = [
    'Activity ID',
    'Date & Time (UTC)',
    'Date & Time (IST)',
    'Auction ID',
    'Match Number',
    'Transaction ID',
    'Dealer ID',
    'Company Name',
    'Dealer Phone',
    'City',
    'Activity Type',
    'Points Awarded',
    'Amount / Bid Value (INR)',
    'Vehicle ID',
    'Vehicle Name',
    'Registration Number',
    'Fuel Type',
    'Transmission',
    'Year of Mfg',
    'Speedometer',
    'Start Bid Value (INR)',
    'Winning Bid (INR)',
    'Bid Rank',
    'Is Leading Bid',
    'Is Pre-Bid',
    'Total Bids on Vehicle',
    'Deposit Amount (INR)',
    'Campaign Name',
  ];

  const rows = [headers.map(escapeCsv).join(',')];

  for (const a of activities) {
    let meta: any = {};
    try {
      meta = typeof a.metadata === 'string' ? JSON.parse(a.metadata) : (a.metadata || {});
    } catch {
      meta = {};
    }

    const ist = formatIST(a.timestamp);

    rows.push([
      escapeCsv(a.id),
      escapeCsv(ist.iso),
      escapeCsv(ist.full),
      escapeCsv(auctionId),
      escapeCsv(a.match?.matchNumber ? `Match ${a.match.matchNumber}` : 'Match 1'),
      escapeCsv(a.externalTransactionId || ''),
      escapeCsv(a.dealer?.externalDealerId || ''),
      escapeCsv(a.dealer?.displayName || ''),
      escapeCsv(a.dealer?.phone || ''),
      escapeCsv(a.dealer?.city || ''),
      escapeCsv(a.activityType),
      escapeCsv(a.points),
      escapeCsv(meta.bidAmount || meta.winningBid || meta.price || ''),
      escapeCsv(meta.vehicleId || ''),
      escapeCsv(meta.vehicleName || ''),
      escapeCsv(meta.regNo || ''),
      escapeCsv(meta.fuelType || ''),
      escapeCsv(meta.transmission || ''),
      escapeCsv(meta.yearOfMfg || ''),
      escapeCsv(meta.speedometer || ''),
      escapeCsv(meta.startBidValue || ''),
      escapeCsv(meta.winningBid || ''),
      escapeCsv(meta.bidRank || ''),
      escapeCsv(meta.isLeadingBid != null ? (meta.isLeadingBid ? 'YES' : 'NO') : ''),
      escapeCsv(meta.isPreBid != null ? (meta.isPreBid ? 'YES' : 'NO') : ''),
      escapeCsv(meta.totalBids || ''),
      escapeCsv(meta.depositAmount || ''),
      escapeCsv(a.campaign?.name || campaign?.name || 'Dealer Super Cup — September 2026'),
    ].join(','));
  }

  // \uFEFF UTF-8 BOM ensures Excel on Windows renders UTF-8 properly
  const csvContent = '\uFEFF' + rows.join('\n');
  const targetPath = path.resolve(__dirname, '..', '..', 'supercup-auction-activities-2026-09-10.csv');
  const fallbackPath = path.resolve(__dirname, '..', '..', 'supercup-auction-activities-2026-09-10-company-names.csv');

  try {
    fs.writeFileSync(targetPath, csvContent, 'utf-8');
    console.log(`✅ Successfully exported updated CSV with Company Names to: ${targetPath}`);
  } catch (err: any) {
    if (err.code === 'EBUSY') {
      console.warn(`⚠️ Target file ${targetPath} is currently locked (likely open in Excel).`);
      fs.writeFileSync(fallbackPath, csvContent, 'utf-8');
      console.log(`✅ Saved updated CSV with Company Names to: ${fallbackPath}`);
    } else {
      throw err;
    }
  }
}

main()
  .catch(console.error)
  .finally(() => prisma.$disconnect());
</file>

<file path="scripts/rollover_supercup_campaign.ts">
import { PrismaClient } from '@prisma/client';

const prisma = new PrismaClient();

const CAMPAIGN_SLUG = 'supercup-2026-27';
const campaignData = {
  name: 'TVS Certified Super Cup 2026–27',
  startDate: new Date('2026-10-14T18:30:00.000Z'),
  endDate: new Date('2027-01-14T18:29:59.999Z'),
  type: 'SUPER_CUP',
  status: 'ACTIVE',
};

const rules = [
  // SELLING
  ['SELL_LISTING', 5, 'Selling: Points per vehicle listing'],
  ['SELL', 10, 'Selling: Points per vehicle conversion/sold'],
  ['SELL_COMMISSION', 5, 'Selling: Commission points allocation'],
  // BUYING
  ['MATCH_PARTICIPATION', 1, 'Buying: Points for participating in a match day'],
  ['BID_PLACED', 1, 'Buying: Points per verified live auction bid'],
  ['BUY', 10, 'Buying: Points per vehicle conversion/purchased'],
] as const;

const matches = [
  { matchNumber: 1, auctionId: 'TVSC-2026-10-15', date: new Date('2026-10-15T08:30:00.000Z') },
  { matchNumber: 2, auctionId: 'TVSC-2026-11-12', date: new Date('2026-11-12T08:30:00.000Z') },
  { matchNumber: 3, auctionId: 'TVSC-2026-12-10', date: new Date('2026-12-10T08:30:00.000Z') },
  { matchNumber: 4, auctionId: 'TVSC-2027-01-14', date: new Date('2027-01-14T08:30:00.000Z') },
];

async function main() {
  const existingCampaign = await prisma.campaign.findUnique({
    where: { slug: CAMPAIGN_SLUG },
    select: { id: true },
  });

  const campaign = await prisma.$transaction(async (tx) => {
    const activeCampaign = await tx.campaign.upsert({
      where: { slug: CAMPAIGN_SLUG },
      update: campaignData,
      create: { slug: CAMPAIGN_SLUG, ...campaignData },
    });

    for (const [activityType, points, description] of rules) {
      await tx.pointRule.upsert({
        where: { campaignId_activityType: { campaignId: activeCampaign.id, activityType } },
        update: { points, description, active: true },
        create: { campaignId: activeCampaign.id, activityType, points, description, active: true },
      });
    }

    for (const match of matches) {
      await tx.matchDay.upsert({
        where: {
          campaignId_matchNumber: {
            campaignId: activeCampaign.id,
            matchNumber: match.matchNumber,
          },
        },
        update: { date: match.date, auctionId: match.auctionId, status: 'UPCOMING' },
        create: {
          campaignId: activeCampaign.id,
          ...match,
          status: 'UPCOMING',
        },
      });
    }

    if (!existingCampaign) {
      await tx.auditLog.create({
        data: {
          adminUser: 'system',
          action: 'CAMPAIGN_ROLLOVER',
          targetType: 'CAMPAIGN',
          targetId: String(activeCampaign.id),
          details: JSON.stringify({
            slug: CAMPAIGN_SLUG,
            startDate: campaignData.startDate,
            endDate: campaignData.endDate,
            matches: matches.map(({ matchNumber, date, auctionId }) => ({ matchNumber, date, auctionId })),
          }),
          reason: 'Start the corrected Oct 2026–Jan 2027 Super Cup without carrying September test data forward',
        },
      });
    }

    return activeCampaign;
  });

  const dealers = await prisma.dealer.findMany({
    where: { status: 'ACTIVE' },
    select: { id: true },
  });

  for (let i = 0; i < dealers.length; i += 100) {
    const batch = dealers.slice(i, i + 100);
    await prisma.$transaction(
      batch.map(({ id: dealerId }) => prisma.dealerScore.upsert({
        where: { dealerId_campaignId: { dealerId, campaignId: campaign.id } },
        update: {},
        create: { dealerId, campaignId: campaign.id, totalPoints: 0, rank: 0 },
      }))
    );
  }

  console.log(JSON.stringify({
    campaignId: campaign.id,
    campaign: campaign.name,
    startDate: campaign.startDate,
    endDate: campaign.endDate,
    matches: matches.length,
    dealersInitialized: dealers.length,
  }, null, 2));
}

main()
  .catch((error) => {
    console.error(error);
    process.exitCode = 1;
  })
  .finally(async () => {
    await prisma.$disconnect();
  });
