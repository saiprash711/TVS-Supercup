        if (!token) {
          this.userMapExpiry = Date.now() + 1000 * 60 * 5;
          return;
        }
        const res = await fetch(`${this.baseUrl}/users`, {
          headers: { 'Authorization': token, 'Content-Type': 'application/json' },
